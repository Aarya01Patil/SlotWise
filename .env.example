# Synthetic patients only. Never enter a real patient's information.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Choose gemini or groq. Omit LLM_PROVIDER to prefer Groq when its key is present.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Lowercase groq_api_key is also accepted.
GROQ_MODEL=openai/gpt-oss-20b
SLOTWISE_MODE=live
# Live eval pacing in seconds; lower values may exhaust free-tier limits.
SLOTWISE_EVAL_INTERVAL=12
# Render sets RENDER_EXTERNAL_HOSTNAME automatically. Local defaults are private.
SLOTWISE_PUBLIC=0
# Set only when hosting elsewhere; exact hostname, without a scheme or path.
SLOTWISE_HOSTNAME=
# Public evaluation runs require a random token of at least 24 characters.
SLOTWISE_OPERATOR_TOKEN=
